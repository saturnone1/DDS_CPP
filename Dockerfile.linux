ARG ROCKY_VERSION=9.7
FROM rockylinux/rockylinux:${ROCKY_VERSION} AS build

ARG DDSCPP_ENABLE_RTI=OFF
RUN dnf install -y gcc-c++ cmake make ca-certificates \
    && dnf clean all

WORKDIR /src
COPY DDSCPP /src/DDSCPP
COPY DDS_Nuget/definitions /src/DDS_Nuget/definitions

RUN cmake -S DDSCPP -B DDSCPP/build-linux \
        -DCMAKE_BUILD_TYPE=Release \
        -DDDSCPP_ENABLE_RTI=${DDSCPP_ENABLE_RTI} \
    && cmake --build DDSCPP/build-linux \
    && ctest --test-dir DDSCPP/build-linux --output-on-failure
