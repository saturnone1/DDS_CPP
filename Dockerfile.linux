ARG ROCKY_VERSION=9.7
FROM rockylinux/rockylinux:${ROCKY_VERSION}

RUN dnf install -y gcc-c++ cmake make binutils file tar gzip python3 findutils \
    && dnf clean all \
    && rm -rf /var/cache/dnf

COPY tools/build-linux.sh /usr/local/bin/build-ddscpp-linux
RUN chmod 0755 /usr/local/bin/build-ddscpp-linux

ENTRYPOINT ["/usr/local/bin/build-ddscpp-linux"]
