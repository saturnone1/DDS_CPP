@PACKAGE_INIT@

if(TARGET DDSClient::dds_cpp)
    return()
endif()

set(DDSClient_RTI_HOME "${DDSClient_RTI_HOME}" CACHE PATH
    "RTI Connext DDS installation used by DDSClient consumers")
set(DDSClient_RTI_PLATFORM "${DDSClient_RTI_PLATFORM}" CACHE STRING
    "Optional RTI target directory name or absolute path used by DDSClient consumers")
set(DDSClient_BUILT_RTI_VERSION "@DDSCPP_RTI_PRODUCT_VERSION@")
set(DDSClient_BUILT_RTI_PLATFORM "@DDSCLIENT_RTI_PLATFORM_NAME@")
if(NOT DDSClient_RTI_HOME AND DEFINED ENV{NDDSHOME})
    set(DDSClient_RTI_HOME "$ENV{NDDSHOME}")
endif()
if(NOT DDSClient_RTI_HOME)
    message(FATAL_ERROR
        "DDSClient requires RTI Connext DDS. Set DDSClient_RTI_HOME or NDDSHOME before find_package(DDSClient).")
endif()

if(DDSClient_RTI_PLATFORM)
    if(IS_ABSOLUTE "${DDSClient_RTI_PLATFORM}")
        set(_ddsclient_rti_platform "${DDSClient_RTI_PLATFORM}")
    else()
        set(_ddsclient_rti_platform "${DDSClient_RTI_HOME}/lib/${DDSClient_RTI_PLATFORM}")
    endif()
    if(NOT IS_DIRECTORY "${_ddsclient_rti_platform}")
        message(FATAL_ERROR "Requested RTI platform directory does not exist: ${_ddsclient_rti_platform}")
    endif()
elseif(DDSClient_BUILT_RTI_PLATFORM AND
       IS_DIRECTORY "${DDSClient_RTI_HOME}/lib/${DDSClient_BUILT_RTI_PLATFORM}")
    set(_ddsclient_rti_platform "${DDSClient_RTI_HOME}/lib/${DDSClient_BUILT_RTI_PLATFORM}")
elseif(WIN32)
    file(GLOB _ddsclient_rti_platforms LIST_DIRECTORIES true
        "${DDSClient_RTI_HOME}/lib/x64Win64VS*")
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    file(GLOB _ddsclient_rti_platforms LIST_DIRECTORIES true
        "${DDSClient_RTI_HOME}/lib/arm64Linux*"
        "${DDSClient_RTI_HOME}/lib/aarch64Linux*")
else()
    file(GLOB _ddsclient_rti_platforms LIST_DIRECTORIES true
        "${DDSClient_RTI_HOME}/lib/x64Linux*")
endif()
if(NOT _ddsclient_rti_platform AND NOT _ddsclient_rti_platforms)
    message(FATAL_ERROR
        "No compatible RTI target libraries were found under ${DDSClient_RTI_HOME}/lib.")
endif()
if(NOT _ddsclient_rti_platform)
    list(SORT _ddsclient_rti_platforms COMPARE NATURAL ORDER DESCENDING)
    list(GET _ddsclient_rti_platforms 0 _ddsclient_rti_platform)
    if(DDSClient_BUILT_RTI_PLATFORM)
        message(WARNING
            "DDSClient was built with RTI target ${DDSClient_BUILT_RTI_PLATFORM}, which is not installed. "
            "Using ${_ddsclient_rti_platform}. Set DDSClient_RTI_PLATFORM to choose explicitly.")
    endif()
endif()

if(DDSClient_BUILT_RTI_VERSION AND EXISTS "${DDSClient_RTI_HOME}/rti_versions.xml")
    file(READ "${DDSClient_RTI_HOME}/rti_versions.xml" _ddsclient_rti_versions_xml)
    string(REGEX MATCH "<base_version>[ \\t\\r\\n]*([^<]+)" _ddsclient_rti_version_match
        "${_ddsclient_rti_versions_xml}")
    if(CMAKE_MATCH_1)
        string(STRIP "${CMAKE_MATCH_1}" DDSClient_FOUND_RTI_VERSION)
        if(NOT DDSClient_FOUND_RTI_VERSION VERSION_EQUAL DDSClient_BUILT_RTI_VERSION)
            message(WARNING
                "DDSClient was built with RTI ${DDSClient_BUILT_RTI_VERSION}; found ${DDSClient_FOUND_RTI_VERSION}. "
                "Continuing because compatible RTI patch releases may be usable.")
        endif()
    endif()
endif()

if(WIN32)
    set(_ddsclient_rti_prefix "")
    set(_ddsclient_rti_suffix ".lib")
else()
    set(_ddsclient_rti_prefix "lib")
    set(_ddsclient_rti_suffix ".so")
endif()
foreach(_ddsclient_rti_name IN ITEMS nddscpp2 nddsc nddscore)
    set(_ddsclient_rti_file
        "${_ddsclient_rti_platform}/${_ddsclient_rti_prefix}${_ddsclient_rti_name}${_ddsclient_rti_suffix}")
    if(NOT EXISTS "${_ddsclient_rti_file}")
        message(FATAL_ERROR "Required RTI library was not found: ${_ddsclient_rti_file}")
    endif()
    list(APPEND _ddsclient_rti_libraries "${_ddsclient_rti_file}")
endforeach()
if(UNIX)
    list(APPEND _ddsclient_rti_libraries dl m pthread rt)
endif()

add_library(DDSClient::rti INTERFACE IMPORTED)
set_target_properties(DDSClient::rti PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES
        "${DDSClient_RTI_HOME}/include;${DDSClient_RTI_HOME}/include/ndds;${DDSClient_RTI_HOME}/include/ndds/hpp"
    INTERFACE_LINK_LIBRARIES "${_ddsclient_rti_libraries}")
if(WIN32)
    set_property(TARGET DDSClient::rti APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS
        DDSCPP_ENABLE_RTI=1 NDDS_DLL_VARIABLE=1 WIN32_LEAN_AND_MEAN=1)
else()
    set_property(TARGET DDSClient::rti APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS
        DDSCPP_ENABLE_RTI=1 RTI_LINUX=1 RTI_UNIX=1 RTI_64BIT=1)
endif()

set(_ddsclient_include_dir "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
set(_ddsclient_library_dir "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")

if(@DDSCLIENT_HAS_SHARED@)
    add_library(DDSClient::dds_cpp_shared SHARED IMPORTED)
    if(WIN32)
        set_target_properties(DDSClient::dds_cpp_shared PROPERTIES
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/dds_cpp.dll"
            IMPORTED_IMPLIB "${_ddsclient_library_dir}/dds_cpp.lib")
    else()
        set_target_properties(DDSClient::dds_cpp_shared PROPERTIES
            IMPORTED_LOCATION "${_ddsclient_library_dir}/libdds_cpp.so")
    endif()
    set_target_properties(DDSClient::dds_cpp_shared PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_ddsclient_include_dir}"
        INTERFACE_LINK_LIBRARIES DDSClient::rti)
    if(WIN32)
        set_property(TARGET DDSClient::dds_cpp_shared APPEND PROPERTY
            INTERFACE_COMPILE_DEFINITIONS DDSCPP_USING_DLL=1)
    endif()
endif()

if(@DDSCLIENT_HAS_STATIC@)
    add_library(DDSClient::dds_cpp_static STATIC IMPORTED)
    if(WIN32)
        set(_ddsclient_static_name "dds_cpp_static.lib")
    else()
        set(_ddsclient_static_name "libdds_cpp.a")
    endif()
    set_target_properties(DDSClient::dds_cpp_static PROPERTIES
        IMPORTED_LOCATION "${_ddsclient_library_dir}/${_ddsclient_static_name}"
        INTERFACE_INCLUDE_DIRECTORIES "${_ddsclient_include_dir}"
        INTERFACE_LINK_LIBRARIES DDSClient::rti)
endif()

add_library(DDSClient::dds_cpp INTERFACE IMPORTED)
if(DDSClient_USE_STATIC_LIBS)
    if(NOT TARGET DDSClient::dds_cpp_static)
        message(FATAL_ERROR "This DDSClient package does not contain a static library.")
    endif()
    set_property(TARGET DDSClient::dds_cpp PROPERTY
        INTERFACE_LINK_LIBRARIES DDSClient::dds_cpp_static)
else()
    if(NOT TARGET DDSClient::dds_cpp_shared)
        message(FATAL_ERROR "This DDSClient package does not contain a shared library.")
    endif()
    set_property(TARGET DDSClient::dds_cpp PROPERTY
        INTERFACE_LINK_LIBRARIES DDSClient::dds_cpp_shared)
endif()

check_required_components(DDSClient)
