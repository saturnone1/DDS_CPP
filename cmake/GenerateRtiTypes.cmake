if(NOT DEFINED RTIDDSGEN OR NOT EXISTS "${RTIDDSGEN}")
    message(FATAL_ERROR "rtiddsgen was not found: ${RTIDDSGEN}")
endif()
if(NOT DEFINED DDS_XML OR NOT EXISTS "${DDS_XML}")
    message(FATAL_ERROR "DDSSim.xml was not found: ${DDS_XML}")
endif()
if(NOT DEFINED TOPICS_XML OR NOT EXISTS "${TOPICS_XML}")
    message(FATAL_ERROR "topics.xml was not found: ${TOPICS_XML}")
endif()

file(MAKE_DIRECTORY "${OUTPUT_DIR}")
execute_process(
    COMMAND "${RTIDDSGEN}" -language C++11 -inputXml -replace -d "${OUTPUT_DIR}" "${DDS_XML}"
    WORKING_DIRECTORY "${RTI_SCHEMA_DIR}"
    RESULT_VARIABLE codegen_result)
if(NOT codegen_result EQUAL 0)
    message(FATAL_ERROR "rtiddsgen failed with exit code ${codegen_result}")
endif()

# The IDL module is named MSG, which collides with Win32's global MSG typedef.
# Rename the Win32 token only while RTI/Windows headers are being included.
if(WIN32)
    set(rename_begin "#if defined(_WIN32)\n#define MSG DDSCPP_WIN32_MSG\n#endif\n")
    set(rename_end "#if defined(_WIN32)\n#undef MSG\n#endif\n")

    file(READ "${OUTPUT_DIR}/DDSSim.hpp" generated_header)
    string(REGEX REPLACE "(#define DDSSim_[A-Za-z0-9_]+_hpp[\r\n]+)" "\\1${rename_begin}" generated_header "${generated_header}")
    string(REPLACE "namespace ENUM {" "${rename_end}namespace ENUM {" generated_header "${generated_header}")
    file(WRITE "${OUTPUT_DIR}/DDSSim.hpp" "${generated_header}")

    foreach(source_name IN ITEMS DDSSim.cxx DDSSimPlugin.cxx)
        file(READ "${OUTPUT_DIR}/${source_name}" generated_source)
        string(REPLACE "#include \"DDSSim" "${rename_end}#include \"DDSSim" generated_source "${generated_source}")
        file(WRITE "${OUTPUT_DIR}/${source_name}" "${rename_begin}${generated_source}")
    endforeach()
endif()

file(READ "${TOPICS_XML}" topics_content)
while(TRUE)
    string(FIND "${topics_content}" "<!--" comment_begin)
    if(comment_begin EQUAL -1)
        break()
    endif()
    string(FIND "${topics_content}" "-->" comment_end)
    if(comment_end EQUAL -1)
        message(FATAL_ERROR "Unterminated XML comment in ${TOPICS_XML}")
    endif()
    math(EXPR comment_length "${comment_end} - ${comment_begin} + 3")
    string(SUBSTRING "${topics_content}" 0 ${comment_begin} before_comment)
    math(EXPR after_begin "${comment_begin} + ${comment_length}")
    string(SUBSTRING "${topics_content}" ${after_begin} -1 after_comment)
    set(topics_content "${before_comment}${after_comment}")
endwhile()
string(REGEX MATCHALL "<topic[ \t\r\n]+[^>]*name[ \t\r\n]*=[ \t\r\n]*[\"'][A-Za-z_][A-Za-z0-9_]*[\"'][^>]*>" topic_tags "${topics_content}")
set(registry "// Generated from topics.xml. Do not edit.\n")
foreach(tag IN LISTS topic_tags)
    string(REGEX REPLACE ".*name[ \t\r\n]*=[ \t\r\n]*[\"']([A-Za-z_][A-Za-z0-9_]*)[\"'].*" "\\1" type_name "${tag}")
    string(APPEND registry "DDSCPP_REGISTER_RTI_TYPE(MSG::${type_name}, ${type_name}, \"${type_name}\")\n")
endforeach()
list(LENGTH topic_tags topic_count)
if(topic_count EQUAL 0)
    message(FATAL_ERROR "No topics were found in ${TOPICS_XML}")
endif()
file(WRITE "${OUTPUT_DIR}/dds_cpp_rti_type_registry.inc" "${registry}")

# Generate canonical JSON field/enum spellings so the C++ CLI matches
# System.Text.Json's case-insensitive property and enum handling.
file(READ "${DDS_XML}" types_content)
string(REGEX MATCHALL "<(member|enumerator)[ \t\r\n]+[^>]*name[ \t\r\n]*=[ \t\r\n]*[\"'][A-Za-z_][A-Za-z0-9_]*[\"'][^>]*>" json_tags "${types_content}")
set(json_names "// Generated from DDSSim.xml. Do not edit.\n")
set(seen_json_names "")
foreach(tag IN LISTS json_tags)
    string(REGEX REPLACE ".*name[ \t\r\n]*=[ \t\r\n]*[\"']([A-Za-z_][A-Za-z0-9_]*)[\"'].*" "\\1" json_name "${tag}")
    list(FIND seen_json_names "${json_name}" json_name_index)
    if(json_name_index EQUAL -1)
        list(APPEND seen_json_names "${json_name}")
        string(APPEND json_names "DDSCPP_JSON_NAME(\"${json_name}\")\n")
    endif()
endforeach()
file(WRITE "${OUTPUT_DIR}/dds_cpp_json_names.inc" "${json_names}")
